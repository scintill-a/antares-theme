  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#666666",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "keyword.operator",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#cccccc",
        "fontStyle": "italic underline"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#ff4444"
      }
    },
    {
      "scope": [
        "variable",
        "support.variable",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#aaaaaa"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#ff4444"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#ff4444",
        "fontStyle": "bold italic underline"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#aaaaaa",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#aaaaaa",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.jsonc",
        "source.json support.type",
        "source.json support.class",
        "source.json entity.name.type",
        "source.json entity.other.inherited-class",
        "source.json.comments support.type",
        "source.json.comments support.class",
        "source.json.comments entity.name.type",
        "source.json.comments entity.other.inherited-class"
      ],
      "settings": {
        "fontStyle": ""
      }
    }
  ]
}